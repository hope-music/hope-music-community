{
	"$schema": "node_modules/wrangler/config-schema.json",
	"main": ".open-next/worker.js",
	"name": "hope-music-community",
	"compatibility_date": "2026-06-29",
	"compatibility_flags": [
		"nodejs_compat",
		"global_fetch_strictly_public"
	],
	"assets": {
		"directory": ".open-next/assets",
		"binding": "ASSETS"
	},
	"vars": {
		"NEXT_PUBLIC_CONVEX_URL": "https://anonymous-hope-music-community.convex.cloud",
		"NEXT_PUBLIC_CONVEX_SITE_URL": "https://anonymous-hope-music-community.convex.site"
	},
	"services": [
		{
			// Self-reference service binding, the service name must match the worker name
			// see https://opennext.js.org/cloudflare/caching
			"binding": "WORKER_SELF_REFERENCE",
			"service": "hope-music-community"
		}
	],
	"routes": [
		{
			"pattern": "hope-music.com",
			"custom_domain": true
		},
		{
			"pattern": "www.hope-music.com",
			"custom_domain": true
		}
	],
	"images": {
		// Enable image optimization
		// see https://opennext.js.org/cloudflare/howtos/image
		"binding": "IMAGES"
	}
}